// ------------------------------------ Nextflow Metrics & Reports ------------------------------------
timeline {
  enabled = true
  file    = "./epistasis_analysis_timeline.html"
}

report {
  enabled = true
  file    = "./epistasis_analysis_report.html"
}

trace {
  enabled = true
  fields  = 'task_id,name,status,exit,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
  file    = "./epistasis_analysis_trace.txt"
}

// ------------------------------------ Profiles ------------------------------------
profiles {
  // ========== 执行器配置 ==========
  local {
    process.executor = 'local'
    
    executor {
      name         = 'local'
      cpus         = 70              // 全局 CPU 上限
      memory       = '350 GB'        // 全局内存上限
      queueSize    = 65              // 并发任务数上限
      pollInterval = '15 sec'
      dumpInterval = '5 min'
    }
  }

  slurm {
    process {
      executor = 'slurm'
      queue    = 'batch'
      time     = '8h'
    }
    
    executor {
      queueSize    = 100
      pollInterval = '30 sec'
    }
  }

  // ========== 软件环境配置 ==========
  // 注意：这些 profile 必须重复声明 executor 设置以确保继承
  with_conda {
    // ✅ 继承 local 的执行器配置
    process.executor = 'local'
    executor {
      name         = 'local'
      cpus         = 70
      memory       = '350 GB'
      queueSize    = 65
      pollInterval = '15 sec'
      dumpInterval = '5 min'
    }
    
    // Conda 配置
    conda {
      enabled         = true
      useMicromamba   = true
      createOptions   = '--yes'
    }
  }

  with_docker {
    // ✅ 继承 local 的执行器配置
    process.executor = 'local'
    executor {
      name         = 'local'
      cpus         = 70
      memory       = '350 GB'
      queueSize    = 65
      pollInterval = '15 sec'
      dumpInterval = '5 min'
    }
    
    // Docker 配置
    docker {
      enabled    = true
      runOptions = '-u $(id -u):$(id -g)'
    }
  }

  with_singularity {
    // ✅ 用于 SLURM + Singularity
    process {
      executor = 'slurm'
      queue    = 'batch'
      time     = '8h'
    }
    
    executor {
      queueSize    = 100
      pollInterval = '30 sec'
    }
    
    // Singularity 配置
    singularity {
      enabled  = true
      cacheDir = "${baseDir}/.singularity"
    }
  }
}
// ------------------------------------ Profiles ------------------------------------